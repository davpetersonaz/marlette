<script>
function toggleBio(btn) {
    const container = btn.closest('.expandable-bio');
    const short = container.querySelector('.short-bio');
    const full = container.querySelector('.full-bio');
    if (full.classList.contains('hidden')) {
        short.classList.add('hidden');
        full.classList.remove('hidden');
        btn.innerHTML = 'Read less ↑';
    } else {
        short.classList.remove('hidden');
        full.classList.add('hidden');
        btn.innerHTML = 'Read more ↓';
    }
}

// Auto-truncate and hide button if short
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.expandable-bio').forEach(container => {
        const fullTextEl = container.querySelector('.full-bio');
        const shortEl = container.querySelector('.short-bio');
        const button = container.querySelector('button');
        if (fullTextEl && shortEl && button) {
            const fullText = fullTextEl.innerText.trim();
            // Truncate to ~195 characters
            const truncated = fullText.length > 195 
                ? fullText.substring(0, 195).trim() + '...' 
                : fullText;
            shortEl.textContent = truncated;
            // Hide "Read more" if text is short
            if (fullText.length < 200) {
                button.style.display = 'none';
                shortEl.classList.remove('line-clamp-4'); // show full if very short
            }
        }
    });
});
</script>

