<!-- /views/meet-the-team.ejs -->
<%- include('partials/header') %>

<!-- PAGE HEADER -->
<section class="pt-20 pb-16 bg-[color:var(--warm-white)]">
    <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-5xl md:text-6xl font-bold text-navy mb-6">Meet the Team</h1>
        <p class="text-2xl md:text-3xl text-gray-600 max-w-3xl mx-auto leading-tight">
            The neighbors who show up and do the work for Marlette Precinct
        </p>
    </div>
</section>

<!-- TEAM GRID -->
<section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-14">

            <!-- Team Member 1 -->
            <div class="text-center group">
                <div class="mx-auto w-60 h-60 rounded-full overflow-hidden border-8 border-white shadow-2xl mb-8 transition-transform duration-500 group-hover:scale-105">
                    <img src="/images/vol1-dina.jpg" alt="Dina" class="w-full h-full object-cover">
                </div>
                <h3 class="text-2xl font-semibold text-navy mb-1">Dina</h3>
                <p class="text-accent font-medium mb-6">Precinct Committeeman Candidate</p>
                <p class="text-gray-600 px-4 leading-relaxed">
                    Longtime Marlette resident with years of experience door-knocking, registering voters, and supporting conservative candidates.
                </p>
            </div>

            <!-- Team Member 2 -->
            <div class="text-center group">
                <div class="mx-auto w-60 h-60 rounded-full overflow-hidden border-8 border-white shadow-2xl mb-8 transition-transform duration-500 group-hover:scale-105">
                    <img src="/images/vol2.jpg" alt="Volunteer" class="w-full h-full object-cover">
                </div>
                <h3 class="text-2xl font-semibold text-navy mb-1">Volunteer</h3>
                <p class="text-accent font-medium mb-6">Volunteer Coordinator</p>
                <p class="text-gray-600 px-4 leading-relaxed">
                    Dedicated conservative activist focused on building strong community networks and election day operations.
                </p>
            </div>

            <!-- Team Member 3 - Forrest -->
            <div class="text-center group">
                <div class="mx-auto w-60 h-60 rounded-full overflow-hidden border-8 border-white shadow-2xl mb-8 transition-transform duration-500 group-hover:scale-105">
                    <img src="/images/vol3-forrest.jpg" alt="Forrest" class="w-full h-full object-cover">
                </div>
                <h3 class="text-2xl font-semibold text-navy mb-1">Forrest</h3>
			    <p class="text-accent font-medium mb-6">Grassroots Organizer & Former LD 26 Chairman</p>
                <p class="text-gray-600 px-4 leading-relaxed">
					Forrest has lived in Marlette Precinct for 37 years with his wife Lisa. They have 4 adult children and one grandchild. 
					He retired in 2021 after a long career as an Environmental Scientist, most recently at the Palo Verde Nuclear Generating Station.
				</p>
				<p class="text-gray-600 px-4 leading-relaxed mt-4">
					He served as a Precinct Committeeman from 2022–2024 and as Chairman of Legislative District 26. 
					For the past two years, Forrest has provided leadership, mentoring, and voter data expertise while working closely with this team 
					to elect Republican candidates and build a strong grassroots operation.
                </p>
            </div>

            <!-- Team Member 4 -->
            <div class="text-center group">
                <div class="mx-auto w-60 h-60 rounded-full overflow-hidden border-8 border-white shadow-2xl mb-8 transition-transform duration-500 group-hover:scale-105">
                    <img src="/images/vol4.jpg" alt="Volunteer" class="w-full h-full object-cover">
                </div>
                <h3 class="text-2xl font-semibold text-navy mb-1">Volunteer</h3>
                <p class="text-accent font-medium mb-6">Grassroots Organizer</p>
                <p class="text-gray-600 px-4 leading-relaxed">
                    Passionate about petition drives, campaign sign installation, and getting conservatives to the polls.
                </p>
            </div>

        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-14">

            <!-- Team Member 5 -->
            <div class="text-center group">
                <div class="mx-auto w-60 h-60 rounded-full overflow-hidden border-8 border-white shadow-2xl mb-8 transition-transform duration-500 group-hover:scale-105">
                    <img src="/images/vol5-ricky.jpg" alt="Ricky" class="w-full h-full object-cover">
                </div>
                <h3 class="text-2xl font-semibold text-navy mb-1">Ricky</h3>
                <p class="text-accent font-medium mb-6">Precinct Committeeman Candidate</p>
                <p class="text-gray-600 px-4 leading-relaxed">
                    Longtime Marlette resident with years of experience door-knocking and supporting conservative candidates.
                </p>
            </div>

            <!-- Team Member 6 -->
            <div class="text-center group">
                <div class="mx-auto w-60 h-60 rounded-full overflow-hidden border-8 border-white shadow-2xl mb-8 transition-transform duration-500 group-hover:scale-105">
                    <img src="/images/vol6.jpg" alt="Volunteer" class="w-full h-full object-cover">
                </div>
                <h3 class="text-2xl font-semibold text-navy mb-1">Volunteer</h3>
                <p class="text-accent font-medium mb-6">Volunteer Coordinator</p>
                <p class="text-gray-600 px-4 leading-relaxed">
                    Dedicated conservative activist focused on building strong community networks and running smooth election day operations.
                </p>
            </div>

            <!-- Team Member 7 -->
            <div class="text-center group">
                <div class="mx-auto w-60 h-60 rounded-full overflow-hidden border-8 border-white shadow-2xl mb-8 transition-transform duration-500 group-hover:scale-105">
                    <img src="/images/vol7.jpg" alt="Volunteer" class="w-full h-full object-cover">
                </div>
                <h3 class="text-2xl font-semibold text-navy mb-1">Volunteer</h3>
                <p class="text-accent font-medium mb-6">Grassroots Organizer</p>
                <p class="text-gray-600 px-4 leading-relaxed">
                    Passionate about petition drives, campaign sign installation, and getting conservatives to the polls.
                </p>
            </div>

        </div>
    </div>
</section>

<!-- CALL TO ACTION -->
<section class="py-24 bg-navy text-white text-center">
    <div class="max-w-2xl mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Want to join the team?</h2>
        <p class="text-xl mb-10">We’re always looking for more neighbors who want to help strengthen Marlette Precinct.</p>
        <a href="/contact" class="inline-block bg-accent hover:bg-red-700 px-14 py-7 rounded-3xl text-2xl font-semibold transition-all shadow-lg">
			Volunteer With Us
        </a>
    </div>
</section>

<!-- WHAT WE'VE ACCOMPLISHED -->
<section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-4xl font-bold text-navy text-center mb-4">What We've Accomplished</h2>
        <div class="w-48 h-1 bg-accent mx-auto mb-12"></div>

        <div class="space-y-16">

			<!-- Postcard Writing -->
			<div class="grid md:grid-cols-2 gap-10 items-center">
				<div class="grid grid-cols-2 gap-4">
					<img src="/images/PC picture 7-cropped.jpeg" 
						alt="Postcard Party" 
						class="w-full h-64 object-cover rounded-2xl shadow-md">
					<img src="/images/PC Picture 8-cropped.jpeg" 
						alt="Postcard Party" 
						class="w-full h-64 object-cover rounded-2xl shadow-md">
				</div>
				<div>
					<h3 class="text-2xl font-semibold text-navy mb-4">Postcard Writing Parties</h3>
					<p class="text-gray-600 leading-relaxed">
						We held several postcard writing parties in partnership with EZAZ. 
						Postcards were sent to non-voters encouraging them to register. 
						Since September 2025, over <strong>4,000 people</strong> have registered — 
						<strong>75% with the Republican Party</strong>.
					</p>
				</div>
			</div>

            <!-- Voter Registration -->
            <div class="grid md:grid-cols-2 gap-10 items-center">
                <div>
                    <h3 class="text-2xl font-semibold text-navy mb-4">Voter Registration Tables</h3>
                    <p class="text-gray-600 leading-relaxed">
                        We manned voter registration tables at multiple community events.
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <img src="/images/PC Picture 3-cropped.jpg" 
						alt="Voter Registration" 
						class="w-full h-64 object-cover rounded-2xl shadow-md">
                    <img src="/images/PC Picture 9-cropped.JPG" 
						alt="Voter Registration" 
						class="w-full h-64 object-cover rounded-2xl shadow-md">
                </div>
            </div>

            <!-- Campaign Signs -->
            <div class="grid md:grid-cols-2 gap-10 items-center">
                <div class="grid grid-cols-2 gap-4">
                    <img src="/images/PC Picture 5-cropped.jpg" 
						alt="Campaign Signs" 
						class="w-full h-64 object-cover rounded-2xl shadow-md">
                    <img src="/images/PC Picture 6-cropped.jpeg" 
						alt="Campaign Signs" 
						class="w-full h-64 object-cover rounded-2xl shadow-md">
                </div>
                <div>
                    <h3 class="text-2xl font-semibold text-navy mb-4">Campaign Sign Installation</h3>
                    <p class="text-gray-600 leading-relaxed">
                        We installed hundreds of candidate campaign signs across the precinct.
                    </p>
                </div>
            </div>

            <!-- Voter Guides -->
            <div class="grid md:grid-cols-2 gap-10 items-center">
                <div>
                    <h3 class="text-2xl font-semibold text-navy mb-4">Voter Guides</h3>
                    <p class="text-gray-600 leading-relaxed">
                        In 2024, we delivered <strong>over 10,000 voter guides</strong> (English & Spanish) 
                        to doors and by text messaging.
                    </p>
                </div>
                <img src="/images/Voter Guides Collage.png" alt="Voter Guides Collage" class="rounded-2xl shadow-md">
            </div>

            <!-- Ballot Texting -->
            <div class="grid md:grid-cols-2 gap-10 items-center">
                <img src="/images/Ballot.jpg" alt="Ballot Reminders" class="rounded-2xl shadow-md">
                <div>
                    <h3 class="text-2xl font-semibold text-navy mb-4">Ballot Turn-In Reminders</h3>
                    <p class="text-gray-600 leading-relaxed">
                        We texted hundreds of voters reminding them to return their ballots in 2024.
                    </p>
                </div>
            </div>

            <!-- Petitions -->
            <div>
                <h3 class="text-2xl font-semibold text-navy mb-4">Petition Signature Gathering</h3>
                <p class="text-gray-600 leading-relaxed text-lg">
                    We collected <strong>over 1,000 petition signatures</strong> for Republican candidates.
                </p>
            </div>

        </div>
    </div>
</section>

<%- include('partials/footer') %>