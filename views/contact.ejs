<!-- //views/contact.ejs -->
<%- include('partials/header') %>

<!-- PAGE HEADER -->
<section class="pt-20 pb-16 bg-[color:var(--warm-white)]">
    <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-5xl font-bold text-navy mb-6">Get In Touch</h1>
        <p class="text-2xl text-gray-600 max-w-xl mx-auto">
            Have questions? Want to volunteer? We’d love to hear from you.
        </p>
    </div>
</section>

<!-- CONTACT FORM -->
<section class="py-20 bg-white">
    <div class="max-w-2xl mx-auto px-6">
		<% if (submitted) { %>
			<div class="bg-green-100 border border-green-400 text-green-700 px-6 py-5 rounded-2xl mb-10 text-center text-lg">
				✅ <strong>Thank you!</strong> Your message has been sent successfully.<br>
				We'll get back to you as soon as possible.
			</div>
		<% } else if (error) { %>
			<div class="bg-red-100 border border-red-400 text-red-700 px-6 py-5 rounded-2xl mb-10 text-center text-lg">
				❌ Something went wrong while sending your message.<br>
				Please try again or email us directly at 
				<a href="mailto:marletteprecinct@gmail.com" class="underline">marletteprecinct@gmail.com</a>
			</div>
		<% } %>

        <form action="/contact" method="POST" class="space-y-8">
            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                    <input type="text" name="firstName" required
                           class="w-full px-5 py-4 border border-gray-300 rounded-xl focus:outline-none focus:border-navy">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                    <input type="text" name="lastName" required
                           class="w-full px-5 py-4 border border-gray-300 rounded-xl focus:outline-none focus:border-navy">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                <input type="email" name="email" required
                       class="w-full px-5 py-4 border border-gray-300 rounded-xl focus:outline-none focus:border-navy">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Phone (optional)</label>
                <input type="tel" name="phone"
                       class="w-full px-5 py-4 border border-gray-300 rounded-xl focus:outline-none focus:border-navy">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">How can we help you?</label>
                <textarea name="message" rows="6" required
                          class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-navy resize-y"
                          placeholder="I’d like to volunteer... / I have a question about..."></textarea>
            </div>

            <button type="submit"
                    class="w-full bg-navy hover:bg-accent text-white py-6 rounded-2xl text-xl font-semibold transition-all duration-300">
                Send Message
            </button>
        </form>
    </div>
</section>

<!-- CONTACT INFO -->
<section class="py-16 bg-[color:var(--warm-white)]">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12">
        <div class="text-center md:text-left">
            <h3 class="text-2xl font-semibold text-navy mb-6">Other Ways to Reach Us</h3>
            <div class="space-y-6">
                <div class="flex items-start gap-4">
                    <div class="text-3xl">📍</div>
                    <div>
                        <strong>Marlette Precinct</strong><br>
                        Serving Marlette, Arizona
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="text-3xl">📧</div>
                    <div>
                        <strong>Email:</strong><br>
                        <a href="mailto:marletteprecinct@gmail.com" class="hover:text-accent">marletteprecinct@gmail.com</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center md:text-left">
            <h3 class="text-2xl font-semibold text-navy mb-6">Follow Our Progress</h3>
            <p class="text-gray-600 mb-6">
                Stay updated on our grassroots efforts in Marlette Precinct.
            </p>
            <div class="flex gap-6 justify-center md:justify-start text-4xl">
                <a href="#" class="hover:text-accent transition">📘</a>
                <a href="#" class="hover:text-accent transition">𝕏</a>
                <a href="#" class="hover:text-accent transition">📸</a>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>