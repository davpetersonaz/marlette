<!-- /views/contact.ejs -->
<%- include('partials/header') %>

<!-- PAGE HEADER -->
<section class="pt-20 pb-16 bg-[color:var(--warm-white)]">
    <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-5xl font-bold text-navy mb-6">Get In Touch</h1>
        <p class="text-2xl text-gray-600 max-w-xl mx-auto">
            Have questions? Want to volunteer? <br />
			We’d love to hear from you.
        </p>
    </div>
</section>

<!-- CONTACT FORM -->
<section class="py-20 bg-white">
    <div class="max-w-2xl mx-auto px-6">
		<% if (submitted) { %>
			<div class="bg-green-100 border border-green-400 text-green-700 px-6 py-5 rounded-2xl mb-10 text-center text-lg">
                ✅ <strong>Thank you!</strong> Your message has been received.<br>
                We'll get back to you soon.
			</div>
		<% } else if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-6 py-5 rounded-2xl mb-10 text-center">
                ❌ Something went wrong. Please try again.
			</div>
		<% } %>

        <form action="/contact" method="POST" class="space-y-8">
            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                    <input type="text" name="firstName" required class="w-full px-5 py-4 border border-gray-300 rounded-xl focus:outline-none focus:border-navy">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                    <input type="text" name="lastName" required class="w-full px-5 py-4 border border-gray-300 rounded-xl focus:outline-none focus:border-navy">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                <input type="email" name="email" required class="w-full px-5 py-4 border border-gray-300 rounded-xl focus:outline-none focus:border-navy">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Phone (optional)</label>
                <input type="tel" name="phone" class="w-full px-5 py-4 border border-gray-300 rounded-xl focus:outline-none focus:border-navy">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Message / Comments</label>
                <textarea name="message" rows="5" class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-navy resize-y"></textarea>
            </div>

            <!-- Volunteering Options -->
			<div>
                <label class="block text-sm font-medium text-gray-700 mb-3">Interested in Volunteering? (check all that apply)</label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                    <label class="flex items-center gap-2"><input type="checkbox" name="volunteerOptions" value="door_knocking"> Door Knocking / Neighborhood Walks</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="volunteerOptions" value="poll_worker"> Poll Worker / Election Day</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="volunteerOptions" value="phone_calls"> Phone Banking / Calling Voters</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="volunteerOptions" value="texting"> Texting Voters</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="volunteerOptions" value="signs"> Putting Up Signs</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="volunteerOptions" value="fundraising"> Fundraising / Donations</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="volunteerOptions" value="other"> Other / Just Want to Help</label>
				</div>
			</div>

            <button type="submit" class="w-full bg-navy hover:bg-accent text-white py-6 rounded-2xl text-xl font-semibold transition-all">
                Submit
            </button>
        </form>
    </div>
</section>

<%- include('partials/footer') %>