<!-- /views/admin-users.ejs -->
<%- include('partials/header') %>

<section class="py-12 bg-[color:var(--warm-white)] min-h-screen">
    <div class="max-w-6xl mx-auto px-6">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-4xl font-bold text-navy">Admin Users</h1>
            <a href="/admin/invite" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-2xl text-sm font-medium flex items-center gap-2">
                + Invite New Admin
            </a>
        </div>

        <div class="bg-white rounded-3xl shadow overflow-hidden">
            <table class="w-full">
                <thead class="bg-navy text-white">
                    <tr>
                        <th class="px-6 py-4 text-left">Name</th>
                        <th class="px-6 py-4 text-left">Email</th>
                        <th class="px-6 py-4 text-left">Joined</th>
                        <th class="px-6 py-4 text-center">Status</th>
                        <th class="px-6 py-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    <% admins.forEach(admin => { %>
						<tr class="hover:bg-gray-50">
							<td class="px-6 py-4 font-medium"><%= admin.name || '—' %></td>
							<td class="px-6 py-4"><%= admin.email %></td>
							<td class="px-6 py-4 text-sm text-gray-500">
								<%= new Date(admin.created_at).toLocaleDateString() %>
							</td>
							<td class="px-6 py-4 text-center">
								<span class="px-3 py-1 rounded-full text-xs <%= admin.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
									<%= admin.active ? 'Active' : 'Inactive' %>
								</span>
							</td>
							<td class="px-6 py-4 text-center">
								<button onclick="reInvite('<%= admin.email %>')" class="text-blue-600 hover:text-blue-800 text-sm font-medium mr-4">
									Re-invite
								</button>
								<button onclick="deleteAdmin('<%= admin.id %>')" class="text-red-600 hover:text-red-800 text-sm font-medium">
									Delete
								</button>
							</td>
						</tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
function reInvite(email) {
    if (confirm(`Send a new invite to ${email}?`)) {
        fetch('/admin/reinvite', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email })
        })
        .then(response => {
            if (response.ok) {
                alert('Invite sent successfully!');
                location.reload();
            } else {
                alert('Failed to send invite');
            }
        })
        .catch(err => {
            console.error(err);
            alert('Failed to send invite');
        });
    }
}

function deleteAdmin(id) {
    if (confirm('Delete this admin?')) {
        fetch('/admin/delete-admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: parseInt(id) })
        })
        .then(() => location.reload())
        .catch(err => {
            console.error(err);
            alert('Failed to delete admin');
        });
    }
}
</script>

<%- include('partials/footer') %>
