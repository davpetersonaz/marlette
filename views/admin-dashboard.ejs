<!-- /views/admin-dashboard.ejs -->
<%- include('partials/header') %>

<section class="py-12 bg-[color:var(--warm-white)] min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
			<div>
				<h1 class="text-4xl font-bold text-navy">Admin Dashboard</h1>
                <% if (typeof adminName !== 'undefined' && adminName) { %>
                    <p class="text-gray-600">Welcome back, <%= adminName %>!</p>
				<% } %>
			</div>
            <div class="flex flex-wrap gap-3">
				<a href="/admin/users" 
					class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl text-sm font-medium"
				>
					👥 Manage Users
				</a>
				<a href="/admin/invite" 
                   class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-2xl text-sm font-medium flex items-center gap-2"
				>
                    + Invite Admin
				</a>
				<a href="/admin/logout" 
                   class="bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-2xl text-sm font-medium"
				>
					Logout
				</a>
			</div>
		</div>

        <!-- Controls -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
            <label class="flex items-center gap-2 cursor-pointer text-sm">
                <input type="checkbox" id="showDeleted" <%= showDeleted ? 'checked' : '' %> 
                       onchange="toggleDeleted()" class="w-5 h-5 accent-navy">
                <span>Show Deleted Entries</span>
            </label>
            <button onclick="exportToCSV()" 
				class="bg-navy hover:bg-accent text-white px-6 py-3 rounded-xl flex items-center gap-2"
			>
                📥 Export to CSV
            </button>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-3xl shadow overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full min-w-full">
					<thead class="bg-navy text-white">
						<tr>
							<th class="px-4 py-4 text-left">Date</th>
							<th class="px-4 py-4 text-left">Name</th>
							<th class="px-4 py-4 text-left">Type</th>
							<th class="px-4 py-4 text-left hidden sm:table-cell">Email</th>
							<th class="px-4 py-4 text-left">Interests</th>
							<th class="px-4 py-4 text-center">Flag</th>
							<th class="px-4 py-4 text-center">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						<% submissions.forEach(sub => { %>
							<tr class="hover:bg-gray-50 cursor-pointer <%= sub.deleted_at ? 'opacity-60 line-through' : '' %>" 
								data-submission-id="<%= sub.id %>"
								onclick="showSubmissionDetail(this)"
							>
								<td class="px-4 py-4 text-sm"><%= new Date(sub.created_at).toLocaleDateString() %></td>
								<td class="px-4 py-4 font-medium"><%= sub.first_name %> <%= sub.last_name %></td>
								<td class="px-4 py-4">
									<span class="px-3 py-1 rounded-full text-xs <%= sub.type === 'volunteer' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700' %>">
										<%= sub.type %>
									</span>
								</td>
								<td class="px-4 py-4 text-sm hidden sm:table-cell break-all"><%= sub.email %></td>
								<td class="px-4 py-4 text-sm">
									<%= sub.volunteer_options && sub.volunteer_options.length ? sub.volunteer_options.join(', ') : '—' %>
								</td>
								<td class="px-4 py-4 text-center">
									<button onclick="event.stopImmediatePropagation(); toggleHighlight(this)"
										data-id="<%= sub.id %>"
										data-highlighted="<%= sub.highlighted %>"
										class="text-3xl transition hover:scale-110 <%= sub.highlighted ? 'text-yellow-500' : 'text-gray-300' %>"
									>
										<%= sub.highlighted ? '★' : '☆' %>
									</button>
								</td>
                            	<td class="px-4 py-4 text-center" onclick="event.stopImmediatePropagation()">
									<% if (!sub.deleted_at) { %>
									<form action="/admin/delete" method="POST" style="display: inline;">
										<input type="hidden" name="id" value="<%= sub.id %>">
											<button type="submit" onclick="return confirm('Delete this?')" 
													class="text-red-600 hover:text-red-800 text-sm font-medium">Delete</button>
									</form>
									<% } else { %>
										<span class="text-xs text-gray-400">Deleted</span>
									<% } %>
								</td>
							</tr>
						<% }) %>
					</tbody>
				</table>
            </div>
        </div>
    </div>
</section>

<!-- Submission Detail Modal -->
<div id="submissionModal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
    <div class="bg-white rounded-3xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-auto">
        <div class="p-8">
            <div class="flex justify-between items-start mb-6">
                <h2 class="text-3xl font-bold text-navy" id="modalName"></h2>
                <button onclick="closeModal()" class="text-3xl text-gray-400 hover:text-gray-600">×</button>
            </div>
            
            <div class="space-y-6 text-gray-700" id="modalContent">
                <!-- Populated by JS -->
            </div>
            <!-- Delete Button -->
            <div class="mt-8 pt-6 border-t flex justify-end">
                <button onclick="deleteFromModal()" 
                        class="bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-2xl font-medium flex items-center gap-2">
                    🗑️ Delete This Submission
                </button>
	        </div>
        </div>
    </div>
</div>

<script>
let currentSubmissionId = null;

function showSubmissionDetail(row) {
    const id = row.getAttribute('data-submission-id');
    currentSubmissionId = id;   // Store ID for delete
    
    fetch(`/admin/submission/${id}`)
        .then(response => response.json())
        .then(sub => {
			const modal = document.getElementById('submissionModal');
			const nameEl = document.getElementById('modalName');
			const contentEl = document.getElementById('modalContent');
			nameEl.textContent = `${sub.first_name} ${sub.last_name}`;
			let html = `
				<p><strong>Email:</strong> ${sub.email || '—'}</p>
				${sub.phone ? `<p><strong>Phone:</strong> ${sub.phone}</p>` : ''}
				<p><strong>Type:</strong> ${sub.type}</p>
				${sub.volunteer_options && sub.volunteer_options.length ? 
					`<p><strong>Volunteer Interests:</strong> ${sub.volunteer_options.join(', ')}</p>` : ''}
				${sub.message ? `<p><strong>Message:</strong><br><span class="whitespace-pre-wrap">${sub.message.replace(/\n/g, '<br>')}</span></p>` : ''}
				<p><strong>Submitted:</strong> ${new Date(sub.created_at).toLocaleString()}</p>
			`;

			contentEl.innerHTML = html;
			modal.classList.remove('hidden');
        })
        .catch(e => {
			console.error(e);
			alert('Could not load submission details');
        });
}

function deleteFromModal() {
    if (!currentSubmissionId){ return; }
    
    if (confirm('Are you sure you want to delete this submission?')) {
        fetch('/admin/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${currentSubmissionId}`
        })
        .then(() => {
            closeModal();
            location.reload(); // Refresh the table
        })
        .catch(err => {
            console.error(err);
            alert('Failed to delete');
        });
	}
}

function closeModal() {
    document.getElementById('submissionModal').classList.add('hidden');
    currentSubmissionId = null;
}

// Close modal when clicking outside
document.getElementById('submissionModal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});

function toggleDeleted() {
    window.location.href = '/admin/dashboard?showDeleted=' + document.getElementById('showDeleted').checked;
}

function toggleHighlight(btn) {
    const id = btn.getAttribute('data-id');
    const currentlyHighlighted = btn.getAttribute('data-highlighted') === 'true';
    const newState = !currentlyHighlighted;
    fetch('/admin/highlight', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            id: parseInt(id), 
            highlighted: newState 
        })
    }).then(() => {
        location.reload();
    }).catch(err => console.error(err));
}

function exportToCSV() {
    window.location.href = '/admin/export-csv';
}
</script>

<%- include('partials/footer') %>