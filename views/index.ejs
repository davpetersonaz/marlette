<!-- /views/index.ejs -->
<%- include('partials/header') %>

<!-- HERO SECTION -->
<section class="relative h-screen flex items-center justify-center overflow-hidden">
    <img src="/images/marlette.jpg" 
         alt="Marlette Precinct Republican Team"
         class="absolute inset-0 w-full h-full object-cover">
    
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/60 to-black/80"></div>
    
    <div class="relative z-10 text-center max-w-5xl px-6 text-white pt-20">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tighter leading-none mb-6">
            The Team That Shows Up
        </h1>
        <p class="text-xl md:text-2xl lg:text-3xl max-w-3xl mx-auto leading-tight">
            Experienced grassroots Republicans serving Marlette Precinct through voter outreach, neighborhood organizing, and conservative action.
        </p>
        
        <!-- Button Group -->
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/accomplishments" 
               class="border-2 border-white hover:bg-white hover:text-navy px-10 py-5 rounded-2xl text-lg md:text-xl font-semibold transition-all duration-300"
			>
                Our Accomplishments
            </a>
            <a href="/contact" 
               class="border-2 border-white hover:bg-white hover:text-navy px-10 py-5 rounded-2xl text-lg md:text-xl font-semibold transition-all duration-300"
			>
                Volunteer With Us
            </a>
        </div>
        <div class="mt-12 flex flex-col sm:flex-row gap-6 justify-center">
            <a href="/negative-claims" 
               class="border-2 border-white hover:bg-white hover:text-navy px-10 py-5 rounded-2xl text-lg md:text-xl font-semibold transition-all duration-300"
			>
                Before You Believe Negative Claims
            </a>
        </div>
    </div>

    <div class="absolute bottom-12 left-1/2 transform -translate-x-1/2 animate-bounce">
        <i class="fa-solid fa-chevron-down text-4xl text-white/70"></i>
    </div>
</section>


<!-- WHO WE ARE -->
<section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-4xl font-bold text-navy text-center mb-4">Real Grassroots Republicans</h2>
        <div class="w-24 h-1 bg-accent mx-auto mb-12"></div>
        
        <div class="max-w-3xl mx-auto text-lg leading-relaxed text-gray-700">
            <p class="mb-8">
                We are neighbors, volunteers, and longtime conservative activists committed to strengthening Marlette Precinct and supporting Republican victories from the ground up.
            </p>
            <p class="mb-10">Our team has years of combined experience in:</p>
            <ul class="grid md:grid-cols-2 gap-x-12 gap-y-4 text-lg">
                <li class="flex items-start gap-3"><span class="text-accent font-bold mt-1">•</span> Door knocking</li>
                <li class="flex items-start gap-3"><span class="text-accent font-bold mt-1">•</span> Voter registration</li>
                <li class="flex items-start gap-3"><span class="text-accent font-bold mt-1">•</span> Petition signature gathering</li>
                <li class="flex items-start gap-3"><span class="text-accent font-bold mt-1">•</span> Campaign sign installation</li>
                <li class="flex items-start gap-3"><span class="text-accent font-bold mt-1">•</span> Volunteer coordination</li>
                <li class="flex items-start gap-3"><span class="text-accent font-bold mt-1">•</span> Election operations</li>
                <li class="flex items-start gap-3"><span class="text-accent font-bold mt-1">•</span> Republican voter outreach</li>
            </ul>
        </div>
    </div>
</section>

<!-- WHY EXPERIENCE MATTERS -->
<section class="py-20 bg-[color:var(--warm-white)]">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="text-4xl font-bold text-navy mb-8">Experience You Can Count On</h2>
                <p class="text-lg leading-relaxed text-gray-700 mb-8">
                    Precinct Committeemen are the foundation of Republican grassroots organization. 
                    Our team brings dedication, organization, reliability, and real campaign experience.
                </p>
                <p class="text-lg font-medium text-navy">
                    We’re already active in the field and ready to serve immediately.
                </p>
            </div>
            <div class="bg-white p-10 rounded-3xl shadow-sm">
                <h3 class="font-semibold text-2xl mb-8 text-navy">What We Do</h3>
                <div class="space-y-6">
                    <div class="flex gap-4">
                        <div class="w-10 h-10 bg-accent/10 text-accent rounded-2xl flex items-center justify-center flex-shrink-0 text-xl">🚪</div>
                        <div class="pt-1">Door-to-door voter outreach</div>
                    </div>
                    <div class="flex gap-4">
                        <div class="w-10 h-10 bg-accent/10 text-accent rounded-2xl flex items-center justify-center flex-shrink-0 text-xl">🗳️</div>
                        <div class="pt-1">Voter registration drives</div>
                    </div>
                    <div class="flex gap-4">
                        <div class="w-10 h-10 bg-accent/10 text-accent rounded-2xl flex items-center justify-center flex-shrink-0 text-xl">📋</div>
                        <div class="pt-1">Petitions &amp; candidate support</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WHAT WE BELIEVE -->
<section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-4xl font-bold text-navy mb-6">Action Over Titles</h2>
        <p class="text-xl text-gray-600 mb-12">Leadership is earned through service.</p>
        
        <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-[color:var(--warm-white)] p-8 rounded-3xl">
                <div class="text-5xl mb-6">🗣️</div>
                <h3 class="font-semibold mb-3 text-xl">Face-to-Face</h3>
                <p class="text-gray-600">Talking with voters in our neighborhoods</p>
            </div>
            <div class="bg-[color:var(--warm-white)] p-8 rounded-3xl">
                <div class="text-5xl mb-6">📣</div>
                <h3 class="font-semibold mb-3 text-xl">Informed Neighbors</h3>
                <p class="text-gray-600">Helping our community stay informed</p>
            </div>
            <div class="bg-[color:var(--warm-white)] p-8 rounded-3xl">
                <div class="text-5xl mb-6">🏆</div>
                <h3 class="font-semibold mb-3 text-xl">Strong Turnout</h3>
                <p class="text-gray-600">Building long-term Republican success</p>
            </div>
        </div>
    </div>
</section>

<%- include('partials/call-to-action') %>

<%- include('partials/footer') %>