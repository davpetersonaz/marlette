<!-- /views/admin-login.ejs -->
<%- include('partials/header') %>

<section class="min-h-screen bg-[color:var(--warm-white)] flex items-center justify-center py-20">
    <div class="max-w-md w-full mx-auto px-6">
        <div class="bg-white rounded-3xl shadow-xl p-10">
            <h1 class="text-4xl font-bold text-navy text-center mb-8">Admin Login</h1>
            
            <% if (error) { %>
                <div class="bg-red-100 text-red-700 p-4 rounded-2xl mb-6 text-center">
                    Invalid username or password
                </div>
            <% } %>

            <form action="/admin/login" method="POST" class="space-y-6">
                <div>
                    <label class="block text-sm font-medium mb-2">Username</label>
                    <input type="text" name="username" required 
                           class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-navy">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Password</label>
                    <input type="password" name="password" required 
                           class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-navy">
                </div>
                <button type="submit" class="w-full bg-navy hover:bg-accent text-white py-5 rounded-2xl text-lg font-semibold">
                    Login
                </button>
            </form>
        </div>
    </div>
</section>

<%- include('partials/footer') %>