<%- include('partials/header') %>

<!-- PAGE HEADER -->
<section class="pt-20 pb-16 bg-[color:var(--warm-white)]">
    <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-5xl md:text-6xl font-bold text-navy mb-6">Before You Believe Negative Claims</h1>
        <p class="text-2xl md:text-3xl text-gray-600 max-w-3xl mx-auto leading-tight">
            Against Our Grassroots Volunteers
        </p>
    </div>
</section>

<!-- MAIN CONTENT -->
<section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
        
        <div class="prose prose-lg max-w-none text-gray-700">
            
            <h2 class="text-3xl font-semibold text-navy mb-6">Before You Believe Negative Claims...</h2>
            <p class="text-lg leading-relaxed mb-4">
				Election season sometimes brings misleading claims, personal attacks, and misinformation — even in local Precinct Committeeman races. 
				Our team expects that false or distorted statements may be circulated through texts, social media, or word of mouth in an effort to damage our reputation.
            </p>
            <p class="text-lg leading-relaxed mb-4">
				Our candidates are committed to integrity, hard work, respectful leadership, and serving the voters of Marlette Precinct. 
				We believe our record of involvement, service, and results speaks for itself.
            </p>
            <p class="text-lg leading-relaxed mb-4">
				If you hear a claim about any member of our team, we respectfully ask that you give us the opportunity to respond directly before drawing conclusions.
            </p>
            <p class="text-lg leading-relaxed">
				Call: <b>602-312-2481</b>
            </p>
            <p class="text-lg leading-relaxed">
				Email: <b>marletteprecinct@gmail.com</b>
            </p>

        </div>
    </div>
</section>

<%- include('partials/call-to-action') %>

