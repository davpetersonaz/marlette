<%- include('partials/header') %>

<!-- PAGE HEADER -->
<section class="pt-20 pb-16 bg-[color:var(--warm-white)]">
    <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-5xl md:text-6xl font-bold text-navy mb-6">What is a Precinct Committeeman?</h1>
        <p class="text-2xl md:text-3xl text-gray-600 max-w-3xl mx-auto leading-tight">
            The foundation of Republican grassroots organizing
        </p>
    </div>
</section>

<!-- MAIN CONTENT -->
<section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
        
        <div class="prose prose-lg max-w-none text-gray-700">
            
            <h2 class="text-3xl font-semibold text-navy mb-6">What is a Precinct Committeeman (PC)?</h2>
            <p class="text-lg leading-relaxed">
                A PC is a Republican elected to represent Republican voters in a specific neighborhood (precinct). 
                Precinct Committeemen serve as a direct link between voters and the Republican Party at the local level.
            </p>

            <h2 class="text-3xl font-semibold text-navy mt-16 mb-6">What does a PC do?</h2>
            <ul class="list-none space-y-4 text-lg">
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Represents Republican voters in the precinct</li>
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Shares election dates and voting information</li>
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Assists with voter registration &amp; turnout</li>
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Participates in Republican Party meetings</li>
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Supports Republican candidates &amp; grassroots efforts</li>
            </ul>

            <h2 class="text-3xl font-semibold text-navy mt-16 mb-6">How this benefits you</h2>
            <ul class="list-none space-y-4 text-lg">
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Provides you with a local Republican contact</li>
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Keeps you (the voter) informed &amp; engaged</li>
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Strengthens our neighborhood representation</li>
                <li class="flex gap-4"><span class="text-accent font-bold">•</span> Improves communication within the Party</li>
            </ul>

        </div>
    </div>
</section>

<%- include('partials/call-to-action') %>

<%- include('partials/footer') %>