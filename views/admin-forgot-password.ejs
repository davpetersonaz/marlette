<!-- /views/admin-forgot-password.ejs -->
<%- include('partials/header') %>

<section class="min-h-screen bg-[color:var(--warm-white)] flex items-center justify-center py-20">
    <div class="max-w-md w-full mx-auto px-6">
        <div class="bg-white rounded-3xl shadow-xl p-10">
            <h1 class="text-3xl font-bold text-navy text-center mb-8">Forgot Password</h1>
            
            <% if (sent) { %>
                <div class="bg-green-100 p-6 rounded-2xl text-center mb-8">
                    ✅ Reset link sent! Check your email.
                </div>
            <% } else if (error) { %>
                <div class="bg-red-100 p-6 rounded-2xl text-center mb-8">
                    ❌ No account found with that email.
                </div>
            <% } %>

            <form action="/admin/forgot-password" method="POST" class="space-y-6">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="block text-sm font-medium mb-2">Email Address</label>
                    <input type="email" name="email" required 
                           class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-navy">
                </div>
                <button type="submit" class="w-full bg-navy hover:bg-accent text-white py-5 rounded-2xl text-lg font-semibold">
                    Send Reset Link
                </button>
            </form>
            
            <div class="text-center mt-6">
                <a href="/admin/login" class="text-navy hover:text-accent">Back to Login</a>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>