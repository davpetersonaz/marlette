                <button id="mobile-menu-btn" class="md:hidden text-3xl">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>

		<!-- Mobile Menu -->
		<div id="mobile-menu" class="hidden md:hidden bg-navy border-t border-blue-800 py-4">
			<div class="px-6 flex flex-col gap-4 text-base">
                <a href="/" class="hover:text-accent py-2">Home</a>
                <a href="/meet-the-team" class="hover:text-accent py-2">Meet the Team</a>
                <a href="/contact" class="hover:text-accent py-2">Volunteer</a>
                <a href="/contact" class="hover:text-accent py-2">Contact</a>
				<% if (typeof adminLoggedIn !== 'undefined' && adminLoggedIn) { %>
                    <a href="/admin" class="bg-white text-navy py-3 text-center rounded-2xl font-semibold">Admin Dashboard</a>
				<% } %>
			</div>
