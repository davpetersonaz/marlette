<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marlette Precinct Republicans | The Team That Shows Up</title>

	<!-- Google Analytics -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-HQC54WX49E"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', 'G-HQC54WX49E');
	</script>

	<link rel="stylesheet" href="/css/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <meta name="description" content="Grassroots Republican team serving Marlette Precinct">
</head>
<body class="bg-[color:var(--warm-white)] text-gray-800 font-sans">

    <!-- NAVBAR -->
    <nav class="bg-navy text-white sticky top-0 z-50 shadow-md">
        <div class="max-w-6xl mx-auto px-6">
            <div class="flex justify-between items-center py-4">
                
                <!-- Logo -->
				<a href="/" class="flex items-center gap-3 hover:opacity-90 transition">
					<div class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-navy font-bold text-xl">
						🇺🇸
					</div>
					<div>
						<span class="text-2xl font-bold tracking-tight">Marlette Precinct</span>
						<p class="text-xs text-blue-200 -mt-1">Republicans</p>
					</div>
				</a>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-8 text-sm font-medium">
                    <a href="/" class="hover:text-accent transition">Home</a>
                    <a href="/meet-the-team" class="hover:text-accent transition">Meet the Team</a>
                    <a href="/contact" class="hover:text-accent transition">Volunteer</a>
                    <a href="/contact" class="hover:text-accent transition">Contact</a>
					<% if (typeof adminLoggedIn !== 'undefined' && adminLoggedIn) { %>
                        <a href="/admin" class="bg-white text-navy px-5 py-2 rounded-xl text-sm font-semibold hover:bg-accent hover:text-white transition">
							👤 Admin
						</a>
					<% } %>
                </div>

